# PayToProvision configuration. Copy to `.env` for local dev; set the same keys on Render.
# Never commit real values. Empty values fall back to defaults.
# `python -m scripts.check_env` verifies every credential you've filled in.

# --- App -------------------------------------------------------------------
# "production" on Render (hides /docs)
APP_ENV=development
# Public URL of this app, e.g. https://paytoprovision.onrender.com
APP_BASE_URL=http://localhost:8000
# Long random strings. On Render the Blueprint generates these.
SECRET_KEY=
ADMIN_TOKEN=
# Sent by the GitHub Actions cron to /internal/reap (Phase 3)
INTERNAL_REAP_TOKEN=
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# On Render this is wired automatically from the Render Postgres in render.yaml.
# Any Postgres URL works (e.g. Neon's direct connection string).
# Empty = local SQLite file (ptp-dev.db).
DATABASE_URL=

# --- Render ----------------------------------------------------------------
# Dashboard -> Account Settings -> API Keys (starts with rnd_)
RENDER_API_KEY=
# Workspace id (tea-... or usr-...). Optional if the key only sees one workspace.
RENDER_OWNER_ID=
# oregon | ohio | virginia | frankfurt | singapore
RENDER_REGION=oregon
# Every preview service gets this prefix; the reaper deletes services with it that no active
# session owns. Use a different one locally (e.g. ptp-dev-) so a dev server sharing the
# Render API key never touches production previews.
PREVIEW_NAME_PREFIX=ptp-dev-
# Render instance type for previews. Free instances share the workspace's 750 free hours/month.
PREVIEW_PLAN=free
# Only change this for testing against a mock server
RENDER_API_BASE_URL=https://api.render.com/v1

# --- GitHub ----------------------------------------------------------------
# Fine-grained PAT with read-only access to public repos. Lifts the 60 req/h anonymous limit.
GITHUB_TOKEN=

# --- Nebius Token Factory (AI) ---------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# check_env lists the Nemotron model IDs your key can use if this one isn't available
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- PayPal (sandbox only) -------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Created in Phase 3, once the app has a public URL
PAYPAL_WEBHOOK_ID=
CURRENCY=USD
PLATFORM_FEE_PERCENT=20

# --- Guardrails ------------------------------------------------------------
# Comma-separated owner/name of repos that may be listed
ALLOWED_REPOS=
MAX_CONCURRENT_PREVIEWS=3
MAX_SESSION_HOURS=2
MAX_HEAL_ATTEMPTS=2
# Hard daily caps shared by all visitors (0 = unlimited). They bound what an abuser can spend:
# ~400 AI calls is well under $1 of Nebius credit; 40 deploys keeps Render builds tiny.
AI_DAILY_CALL_LIMIT=400
DEPLOY_DAILY_LIMIT=40
